# GTA 6 Clip Agent settings. Copy this file to .env (setup does it for you) and fill in what you use.
# Most keys can also be pasted into the app's Accounts page, which writes them here for you.

# Your name for the greeting on the Home page (optional)
DISPLAY_NAME=

# --- AI that picks the best moments (free) --------------------------------------------------------
# A free key from https://console.groq.com/keys. Without one (and without Ollama running),
# clips are cut by the picture's shot changes and get hashtags only.
GROQ_API_KEY=
# Optional: models to try in order; each has its own free rate limit.
# GROQ_MODELS=openai/gpt-oss-120b,llama-3.3-70b-versatile,openai/gpt-oss-20b
# Optional local AI instead: install Ollama and run `ollama pull qwen2.5:7b`
# OLLAMA_MODEL=qwen2.5:7b

# --- Speech to text ---------------------------------------------------------------------------------
# large-v3-turbo on an NVIDIA GPU; the CPU uses WHISPER_CPU_MODEL. Set WHISPER_DEVICE=cpu to skip the GPU.
WHISPER_MODEL=large-v3-turbo
WHISPER_CPU_MODEL=small.en

# --- Telegram approvals (optional): a bot from @BotFather --------------------------------------------
GTA6_TELEGRAM_TOKEN=

# --- Accounts ------------------------------------------------------------------------------------------
# How many posting accounts (any number). Each can be logged in to Instagram, TikTok and YouTube.
ACCOUNTS=5

# Instagram: an app on developers.facebook.com ("Instagram API with Instagram Login")
IG_APP_ID=
IG_APP_SECRET=
# ...or a token per account from that app's dashboard instead of logging in:
# IG_TOKEN_1=
# Instagram downloads each video from a link, so it's hosted for a few minutes in a free Supabase project:
# a PUBLIC storage bucket named "reels", and the project's URL and secret (service_role) key.
SUPABASE_URL=
SUPABASE_KEY=
# SUPABASE_BUCKET=reels

# TikTok: an app on developers.tiktok.com (Login Kit for Desktop + Content Posting API)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Set to 1 once TikTok has approved (audited) your app: clips then post publicly instead of to the inbox.
TIKTOK_AUDITED=

# YouTube: a Google Cloud OAuth client of type "Desktop app", with YouTube Data API v3 turned on
YT_CLIENT_ID=
YT_CLIENT_SECRET=
